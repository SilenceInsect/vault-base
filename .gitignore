references/vault/_kb/secrets.local.json
references/vault/_kb/*.db
references/vault/_kb/baseline.json
references/vault/_kb/last_probe.json
references/vault/_kb/skill-catalog.json
references/vault/_kb/skill-catalog.md
__pycache__/
_extract_from_plan.py
scripts/__pycache__/

# 本机安装状态记录（含内网库名 / 主机地址 / 本机路径，不入库）
/INSTALL-STATUS.md

# WorkBuddy 会话工作记忆（本机上下文，不入库）
/.workbuddy/

# portable local tool installs under this skill (do not commit binaries)
/Obsidian/
/Python/
/Git/
/SVN/

# --- team workspaces (team-type:team-name → teams/<type>/<name>/) ---
teams/**
!teams/README.md
!teams/_template/
!teams/_template/**
!teams/svn-ignore.txt

# --- per-skill 数据目录（<skill_id>/，本地知识资产，卸载保留、不入库） ---
# 顶层除包自身目录外一律视为 per-skill 数据；新增包目录时须同步补 !/<dir>/
# 以及 scripts/skill_vault_adapt.py 的 RESERVED_ROOT_NAMES
/*/
!/scripts/
!/assets/
!/references/
!/teams/
!/docs/
!/knowledge/
!/briefs/
!/hooks/
!/tests/
